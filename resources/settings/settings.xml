<settings>
    <setting propertyKey="@Properties.GmtOffset" title="@Strings.GmtOffsetTitle">
        <settingConfig type="numeric" min="-12" max="14"/>
    </setting>
    <setting propertyKey="@Properties.BezelStyle" title="@Strings.BezelTitle">
        <settingConfig type="list">
            <listEntry value="0">@Strings.Bezel0</listEntry>
            <listEntry value="1">@Strings.Bezel1</listEntry>
            <listEntry value="2">@Strings.Bezel2</listEntry>
            <listEntry value="3">@Strings.Bezel3</listEntry>
            <listEntry value="4">@Strings.Bezel4</listEntry>
        </settingConfig>
    </setting>
</settings>
